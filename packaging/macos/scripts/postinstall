#!/bin/bash
set -e

PLIST="/Library/LaunchDaemons/com.argus.chmodbpf.plist"

# Ensure correct ownership on installed files (pkgbuild payload preserves build-time ownership)
chown root:wheel "/Library/PrivilegedHelperTools/com.argus.chmodbpf"
chmod 755 "/Library/PrivilegedHelperTools/com.argus.chmodbpf"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"

# Unload existing daemon if running (ignore error on first install)
/bin/launchctl unload "$PLIST" 2>/dev/null || true

# Load and run the daemon immediately — no reboot required
/bin/launchctl load "$PLIST"

exit 0
