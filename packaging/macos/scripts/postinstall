#!/bin/bash
set -e

RESOURCES="$PACKAGE_PATH/Contents/Resources"
HELPER_DEST="/Library/PrivilegedHelperTools/com.argus.chmodbpf"
PLIST_DEST="/Library/LaunchDaemons/com.argus.chmodbpf.plist"

# Ensure destination directories exist
mkdir -p /Library/PrivilegedHelperTools
mkdir -p /Library/LaunchDaemons

# Install helper binary: root-owned, executable by group/world
install -o root -g wheel -m 755 "$RESOURCES/chmodbpf" "$HELPER_DEST"

# Install LaunchDaemon plist: root-owned, world-readable
install -o root -g wheel -m 644 "$RESOURCES/com.argus.chmodbpf.plist" "$PLIST_DEST"

# Unload existing daemon if running (ignore error on first install)
/bin/launchctl unload "$PLIST_DEST" 2>/dev/null || true

# Load and run the daemon immediately — no reboot required
/bin/launchctl load "$PLIST_DEST"

exit 0
